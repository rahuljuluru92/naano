# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS -- used exclusively by src/lib/supabase/admin.ts
# (admin/"Managed Campaigns" flows and the demo seed script). Never exposed
# to the client, never referenced from a NEXT_PUBLIC_* var.
SUPABASE_SERVICE_ROLE_KEY=